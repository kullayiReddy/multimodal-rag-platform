# ==============================================================================
# Multimodal RAG Document Intelligence Platform - Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="Multimodal RAG Document Intelligence Platform"

# Backend Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# PostgreSQL Database (with asyncpg)
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@localhost:5432/multimodal_rag
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379/0

# Gemini / Google AI Credentials
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Embedding Provider (google | huggingface | openai)
EMBEDDING_PROVIDER=google
EMBEDDING_DIMENSION=768
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Database (chroma | faiss)
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIR=./data/chroma
FAISS_INDEX_DIR=./data/faiss
CHROMA_COLLECTION_NAME=multimodal_rag

# Retrieval Parameters
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
SCORE_THRESHOLD=0.35
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Document Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CHUNK_SIZE=1024

# Security & Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
MAX_FILE_SIZE_MB=100
ENABLE_PROMPT_INJECTION_DETECTION=true
